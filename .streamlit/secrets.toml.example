# Copy this file to `.streamlit/secrets.toml` and fill in the real values.
# secrets.toml is gitignored — never commit it.
#
# In Streamlit Cloud these same keys go in the app's Settings -> Secrets box,
# pasted as this same TOML, not as a file.

# Shared passcode all four users type to get in.
app_passcode = "choose-something-simple-to-say-out-loud"

# Supabase -> Project Settings -> API
supabase_url = "https://YOUR-PROJECT-REF.supabase.co"
supabase_key = "YOUR-ANON-PUBLIC-KEY"
