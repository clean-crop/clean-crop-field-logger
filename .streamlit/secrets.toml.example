# Real values live in `.streamlit/secrets.toml`, which is gitignored and must
# never be committed. This file is the template beside it.
#
# In Streamlit Cloud these same keys go in the app's Settings -> Secrets box,
# pasted as this same TOML, not as a file.

# Passcode for the people collecting data. They get the entry tabs only.
app_passcode = "choose-something-simple-to-say-out-loud"

# Your passcode. Same app, but also the Data tab, the export, and edit/delete.
# Leave this out entirely and app_passcode grants everything, as it used to.
admin_passcode = "something-different-that-you-keep"

# Supabase -> Project Settings -> API
supabase_url = "https://YOUR-PROJECT-REF.supabase.co"
supabase_key = "YOUR-ANON-PUBLIC-KEY"
